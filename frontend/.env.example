# =============================================================================
# StartStore frontend - environment template
# Copy to `.env` (or `.env.local`). NEVER commit the real file.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# =============================================================================

# --- Django REST API --------------------------------------------------------- #
# Base URL of the backend, WITHOUT a trailing slash. Vite proxies /api in dev,
# so you can leave this pointing at the backend directly.
VITE_API_URL=http://127.0.0.1:8000/api

# --- Supabase ---------------------------------------------------------------- #
# Only needed if you sign in with the Supabase JS client instead of the Django
# token endpoints. The backend accepts a Supabase access token as a bearer token
# either way, so this is optional.
#
# The publishable/anon key is designed to be public. The SERVICE ROLE key is a
# server-only secret: it bypasses Row Level Security and must never appear in a
# VITE_ variable, in source, or in the built bundle.
VITE_SUPABASE_URL=https://eirdrvfhrvixjagilckg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Kc3CvTJPgLvLuY9D2krPYg_ooY1R3Nb
# VITE_SUPABASE_ANON_KEY=          # legacy alias, if your project uses it

# --- Storefront behaviour ---------------------------------------------------- #
# Shown in the announcement bar and used for shipping messaging.
VITE_CURRENCY=USD
VITE_STORE_NAME=StartStore
