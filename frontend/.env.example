# =============================================================================
# StartStore frontend - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env` file.
# Only variables prefixed with VITE_ are inlined into the browser bundle.
# =============================================================================

# --- Django REST API --------------------------------------------------------- #
VITE_API_URL=http://localhost:8000/api

# --- Supabase Auth ----------------------------------------------------------- #
# Both values are PUBLIC by design and may safely use a VITE_ prefix.
# Supabase Auth is the source of truth for identity: the access token it issues
# is what Django validates on every protected request.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ##############################################################################
# # NEVER put any of these behind a VITE_ prefix:                              #
# #   SUPABASE_SERVICE_ROLE_KEY - bypasses Row Level Security                 #
# #   DJANGO SECRET_KEY       - signs API tokens                               #
# #   DATABASE_URL             - contains the database password                #
# # Anything prefixed with VITE_ ships to the browser.                         #
# ##############################################################################

# --- Storefront behaviour ---------------------------------------------------- #
VITE_CURRENCY=USD
VITE_STORE_NAME=StartStore
