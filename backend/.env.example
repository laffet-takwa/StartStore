# =============================================================================
# StartStore - environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# The namespaced DJANGO_* names are also accepted unprefixed:
# SECRET_KEY, DEBUG, ALLOWED_HOSTS and SUPABASE_ANON_KEY.
# =============================================================================

# --- Django core ------------------------------------------------------------- #
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Production REFUSES to boot with the placeholder below.
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
# Comma separated list of trusted origins for CSRF (POST from SPA clients).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only when TLS terminates in front of Django.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO

# --- Database (Supabase PostgreSQL) ------------------------------------------ #
# Your tables (profiles, categories, products, product_images, carts, cart_items,
# wishlists, addresses, orders, order_items) already exist, so record the
# migrations without re-running DDL:
#
#   python manage.py migrate --fake-initial
#
# Use the Supabase connection string. For the pooler use port 6543, for a
# direct connection use 5432. `sslmode=require` is mandatory on Supabase.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_CONN_MAX_AGE=60

# --- Supabase (identity provider) -------------------------------------------- #
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Publishable/anon key. Safe to use server-side; this is what the API sends as
# `apikey` when it calls GoTrue to verify a password or validate a token.
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_AUTH_TIMEOUT=10
# ############################################################################
# #  SUPABASE_SERVICE_ROLE_KEY  ->  SERVER ONLY, AND NOT READ BY THIS CODE.   #
# #  It bypasses Row Level Security and grants full admin access.           #
# #  It must never be returned by the API, embedded in the frontend, or      #
# #  committed to Git. Rotate the key immediately if it ever leaks.          #
# ############################################################################
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# --- CORS (frontend origins) ------------------------------------------------- #
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- JWT --------------------------------------------------------------------- #
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
# Leave empty to reuse DJANGO_SECRET_KEY.
JWT_SIGNING_KEY=
JWT_VERIFYING_KEY=

# --- Throttling -------------------------------------------------------------- #
THROTTLE_ANON_RATE=300/hour
THROTTLE_USER_RATE=2000/hour
THROTTLE_AUTH_LOGIN_RATE=10/minute
THROTTLE_AUTH_REGISTER_RATE=10/hour
THROTTLE_CHECKOUT_RATE=60/hour

# --- Store / commerce rules -------------------------------------------------- #
# Namespaced on purpose: a bare `CURRENCY` is exported by Windows for the user's
# locale (e.g. CURRENCY=TND), which would silently override the store currency.
STARTSTORE_CURRENCY=TND
STARTSTORE_SHIPPING_FLAT_RATE=9.99
STARTSTORE_FREE_SHIPPING_THRESHOLD=100.00
STARTSTORE_CART_ITEM_MAX_QUANTITY=99

# --- Local development only -------------------------------------------------- #
# Set to true to run the test suite / dev server against SQLite instead of
# Supabase. Never enable in production.
USE_SQLITE=False